# Dependencies and build output, rebuilt inside the image
/vendor
/node_modules
/public/build
/public/storage

# The Vite dev server's marker file: shipped by mistake, the live site would try to load
# its assets from localhost:5210.
/public/hot

# Cached manifests from local dev reference dev-only packages (Boost, Pail) that aren't in
# the --no-dev image; they're regenerated in the image.
/bootstrap/cache/*.php

# Local environment and secrets: Coolify provides the environment at runtime
.env
.env.*
!.env.example

# VCS and tooling (.gitignore stays: the assets stage uses it)
.git
.gitattributes
.github
.mcp.json
boost.json

# Development only
/tests
phpunit.xml
compose.yaml
*.md
/storage/logs/*
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/views/*

# OS cruft
.DS_Store
Thumbs.db
